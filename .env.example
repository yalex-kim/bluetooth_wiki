# Required
OPENAI_BASE_URL=http://gpt-oss.your-company.internal/v1
OPENAI_API_KEY=not-needed-for-internal-endpoint

# Agent
BT_AGENT_MODEL=gpt-oss-120b
BT_AGENT_MAX_TURNS=12
BT_AGENT_SEARCH_LIMIT=20
BT_AGENT_SNIPPET_CHARS=240
BT_AGENT_READ_MAX=60000
BT_AGENT_JUDGE_MODEL=gpt-oss-120b

# Search strategy (search/ package): v0=naive baseline, v1=ripgrep (default), v2=hybrid+agentic
BT_AGENT_SEARCH_STRATEGY=v1
BT_AGENT_EMBED_MODEL=BAAI/bge-small-en-v1.5
BT_AGENT_RRF_K=60
BT_AGENT_SUFFICIENCY_MODEL=gpt-oss-120b
BT_AGENT_SUFFICIENCY_MAX_ITER=2

# HTTP test server (server/http.py)
BT_AGENT_HTTP_HOST=0.0.0.0
BT_AGENT_HTTP_PORT=8080

# Site (used by citations.py to build deep links)
SITE_BASE_URL=http://localhost:8000

# Phase 4 — annotations / GitHub Issues backend (not yet used)
# DATABASE_URL=postgresql://user:pass@host:5432/btwiki
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=yalex-kim/bluetooth_wiki

